{
  "name": "focus-pocus",
  "private": true,
  "description": "FocusPocus: the browser extension and its website",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:chrome": "bun --filter @focus-pocus/extension dev:chrome",
    "dev:firefox": "bun --filter @focus-pocus/extension dev:firefox",
    "build:chrome": "bun --filter @focus-pocus/extension build:chrome",
    "build:firefox": "bun --filter @focus-pocus/extension build:firefox",
    "dev:web": "bun --filter @focus-pocus/web dev",
    "build:web": "bun --filter @focus-pocus/web build",
    "store:shots": "bun --filter @focus-pocus/web store:shots",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
