    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
